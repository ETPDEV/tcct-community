# =========================================================
# Edwards Tech Innovation - TCCT
# ---------------------------------------------------------
# Environment Configuration Template
# ---------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =========================================================

# ===================
# API Keys (Optional)
# ===================
# Cloud AI providers - leave blank to use local model only

# Anthropic Claude API (recommended for best quality)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API (optional, for GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API (optional, for fast inference)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# ===================
# Local Model Config
# ===================
# Path to local GGUF model (default: ~/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf)
LOCAL_MODEL_PATH=

# Path to llama.cpp binary (default: ~/llama.cpp/build/bin/llama-cli)
LLAMA_CLI_PATH=

# ===================
# Service Config
# ===================
# Port for agent service (default: 8080)
SERVICE_PORT=8080

# Host to bind (default: 0.0.0.0)
SERVICE_HOST=0.0.0.0

# ===================
# Hardware Bridge
# ===================
# MQTT broker for smart home (optional)
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ===================
# License Key (Pro/Enterprise only)
# ===================
# Your TCCT license key (required for Pro/Enterprise features)
TCCT_LICENSE_KEY=
